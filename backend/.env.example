PORT=4747
DATABASE_URL=postgres://localhost:5432/sadhai_coffee
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
CASH_ENABLED=1
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4747
# dev only: accept orders outside opening hours
IGNORE_STATION_HOURS=0

# Push notifications. Leave blank to run in dry-run mode (deliveries are logged, nothing is sent).
# Web push keys: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sadhaicoffee.com
# Firebase Cloud Messaging (Android and iOS): the service account JSON, raw or base64.
FCM_SERVICE_ACCOUNT_JSON=
# auto = real when configured, else dry run. off = never send.
PUSH_MODE=auto

# --- Production (sadhaicoffee.com) ---
# CORS_ORIGINS=https://sadhaicoffee.com,https://www.sadhaicoffee.com
# PUBLIC_WEB_URL=https://sadhaicoffee.com
# PUBLIC_API_URL=https://api.sadhaicoffee.com
# CASH_ENABLED=1
# IGNORE_STATION_HOURS=0
